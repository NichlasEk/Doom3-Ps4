 }
+
+/* VK_KHR_map_memory2, promoted to Vulkan 1.4. PS4 direct memory keeps its
+ * virtual address for the allocation lifetime. Placed mapping is not exposed. */
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_ps4_MapMemory2(VkDevice device, const VkMemoryMapInfo *info, void **data) {
+    if (!info || !data || info->sType != VK_STRUCTURE_TYPE_MEMORY_MAP_INFO)
+        return VK_ERROR_INITIALIZATION_FAILED;
+    if (info->flags != 0) return VK_ERROR_MEMORY_MAP_FAILED;
+    return vk_ps4_MapMemory(device, info->memory, info->offset, info->size, 0, data);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vk_ps4_UnmapMemory2(VkDevice device, const VkMemoryUnmapInfo *info) {
+    if (!info || !info->memory || info->sType != VK_STRUCTURE_TYPE_MEMORY_UNMAP_INFO)
+        return VK_ERROR_INITIALIZATION_FAILED;
+    if (info->flags != 0) return VK_ERROR_MEMORY_MAP_FAILED;
+    vk_ps4_UnmapMemory(device, info->memory);
+    return VK_SUCCESS;
+}
