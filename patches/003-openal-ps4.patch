+namespace al {
+semaphore::semaphore(unsigned int initial)
+{
+    mSem.count = initial;
+    if (pthread_mutex_init(&mSem.mutex, nullptr))
+        throw std::system_error(std::make_error_code(std::errc::resource_unavailable_try_again));
+    if (pthread_cond_init(&mSem.cond, nullptr)) {
+        pthread_mutex_destroy(&mSem.mutex);
+        throw std::system_error(std::make_error_code(std::errc::resource_unavailable_try_again));
+    }
+}
+semaphore::~semaphore()
+{
+    pthread_cond_destroy(&mSem.cond);
+    pthread_mutex_destroy(&mSem.mutex);
+}
+void semaphore::post()
+{
+    if (pthread_mutex_lock(&mSem.mutex)) std::abort();
+    if (mSem.count == UINT_MAX) {
+        pthread_mutex_unlock(&mSem.mutex);
+        throw std::system_error(std::make_error_code(std::errc::value_too_large));
+    }
+    ++mSem.count;
+    if (pthread_cond_signal(&mSem.cond)) std::abort();
+    if (pthread_mutex_unlock(&mSem.mutex)) std::abort();
+}
+void semaphore::wait() noexcept
+{
+    if (pthread_mutex_lock(&mSem.mutex)) std::abort();
+    while (!mSem.count)
+        if (pthread_cond_wait(&mSem.cond, &mSem.mutex)) std::abort();
+    --mSem.count;
+    if (pthread_mutex_unlock(&mSem.mutex)) std::abort();
+}
+bool semaphore::try_wait() noexcept
+{
+    if (pthread_mutex_lock(&mSem.mutex)) std::abort();
+    const bool ready = mSem.count != 0;
+    if (ready) --mSem.count;
+    if (pthread_mutex_unlock(&mSem.mutex)) std::abort();
+    return ready;
+}
+} // namespace al
